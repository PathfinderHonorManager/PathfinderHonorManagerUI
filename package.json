{
  "name": "pathfinderhonormanagerui",
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@1.22.21",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:local": "VITE_USE_LOCAL_API=true vite dev --port 3000",
    "dev:prod": "VITE_USE_LOCAL_API=false vite dev --port 3000",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 5050",
    "test": "vitest --environment jsdom --run",
    "test:unit": "vitest --environment jsdom --run --exclude \"**/*.integration.spec.ts\"",
    "test:integration": "vitest --config vitest.integration.config.ts --run",
    "test:unit:watch": "vitest --environment jsdom",
    "test:stores": "vitest --environment jsdom --run src/stores/**/*.spec.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . --config eslint.config.js --format compact --fix",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@auth0/auth0-vue": "^2.11.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@microsoft/applicationinsights-web": "^3.4.5",
    "@vue/tsconfig": "^0.9.1",
    "axios": "^1.20.0",
    "fontawesome": "^5.6.3",
    "jwt-decode": "^4.0.0",
    "pinia": "4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prettier": "^3.9.10",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue3-simple-typeahead": "^1.0.11"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jsdom": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "flush-promises": "^1.0.2",
    "jsdom": "^30.1.2",
    "msw": "^3.0.3",
    "semantic-release": "^25.0.9",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
